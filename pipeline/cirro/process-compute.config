process {
    // Out of memory (137-140): again with twice the memory; anything else is the analysis's own
    // failure, which run.json and the task log explain, and would fail again.
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries = 2
    withLabel: cytoweave {
        cpus = 8
        memory = { 32.GB * task.attempt }
    }
}
