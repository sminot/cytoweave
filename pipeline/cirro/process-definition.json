{
  "id": "cytoweave-run",
  "name": "Apply a CytoWeave template",
  "desc": "Applies a CytoWeave analysis template to every FCS file of a dataset and writes its tables, batch report, workspace, methods and a record of every count.",
  "executor": "NEXTFLOW",
  "category": "Flow Cytometry",
  "pipelineTypeOverride": "Community",
  "documentationUrl": "https://github.com/robert-mcdermott/cytoweave/tree/main/pipeline",
  "parentProcessIds": ["fcs"],
  "childProcessIds": [],
  "dataType": "CytoWeave analysis",
  "code": {
    "repository": "GITHUBPUBLIC",
    "uri": "robert-mcdermott/cytoweave",
    "script": "pipeline/main.nf",
    "version": "main"
  },
  "allowMultipleSources": false,
  "usesSampleSheet": true,
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py"
}
