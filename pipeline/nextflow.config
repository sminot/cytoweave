manifest {
    name = 'cytoweave-run'
    description = 'Applies a CytoWeave analysis template to FCS files with cytoweave run'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

params {
    input = null
    fcs = null
    template = null
    annotations = null
    outdir = 'results'
    report = 'pdf'
    report_by = null
    qc = false
    flowjo = false
    review = false
    certificate = false
    // cytoweave run's own limit (a Go duration).
    timeout = '12h'
    container = 'public.ecr.aws/cirrobio/cytoweave-run:0.8.0'
}

process {
    withLabel: cytoweave {
        container = params.container
        cpus = 4
        memory = 16.GB
    }
}

docker.enabled = true
